  "project-settings": [
    {
        "key": "module-description",
        "type": "descriptive",
        "name": "<h5><strong>Module Configuration</strong></h5>"
    },
    {
        "key": "enable-sunet-irb-search",
        "name": "<b>Enable SUNET ID to IRB Number Lookup</b><br>If enabled, the module will lookup IRB Numbers associated with a SUNET ID, and output metadata from a selected IRB",
        "type": "checkbox",
        "required": false
    },
    {
        "key": "sunet-id-field",
        "name": "<b>SUNET ID Field</b><br>Please enter a SUNET to lookup the associated IRB Numbers for this user",
        "type": "field-list",
        "required": true,
        "branchingLogic": {
          "field": "enable-sunet-irb-search",
          "value": "1"
        }
    },
    {
      "key": "enforce-sunet-irb-search",
      "name": "<b>Enforce SUNET ID to IRB Number Lookup</b><br>If enabled, the module will only return results for the currently logged-in user. This effects both searching protocol by SUNET and by IRB<br><em>NOTE: If the SUNET field is embedded on a public survey, the rejection popup will always show unless <strong>webauth_user</strong> exists in the DOM & is enabled on the survey</em>",
      "type": "checkbox",
      "required": true,
      "branchingLogic": {
        "field": "enable-sunet-irb-search",
        "value": "1"
      }
    },
    {
      "key": "enable-irb-search",
      "name": "<b>Enable IRB Number Lookup</b><br>If enabled, the module will lookup manually provided IRB Numbers and pull in associated metadata from the Compliance API",
      "type": "checkbox",
      "required": false
    },
    {
      "key": "irb-field",
      "name": "<b>IRB Field</b><br>The IRB field housing the number to pull eProtocol information for",
      "type": "field-list",
      "branchingLogic": {
        "field": "enable-irb-search",
        "value": "1"
      },
      "required": true
    },
    {
        "key": "mapping-fields-description",
        "type": "descriptive",
        "name": "<h5><strong>eProtocol Attribute Mapping Designations</strong></h5>"
    },
    {
        "key": "irb-mapping-field",
        "name": "<b>IRB Mapping Field</b><br>Select the field in this project that contains the IRB Number to look up",
        "repeatable":true,
        "type": "sub_settings",
        "sub_settings":[
          {
            "key": "variable-name",
            "name": "<b>REDCap Form field</b><br>The variable name of the REDCap field that will store below eProtocol Attribute",
            "type": "field-list",
            "required": true
          },
          {
            "key": "eprotocol-attribute",
            "name": "<b>eProtocol Attribute</b><br>The eProtocol Attribute to map from the Compliance API",
            "type": "text",
            "required": true
          }
        ]
    }
  ]
